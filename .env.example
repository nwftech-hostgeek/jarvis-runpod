# Jarvis stack configuration
# Copy to .env, replace every "change-me" value, and keep .env out of source control.

COMPOSE_PROJECT_NAME=jarvis

# Persistent data. RunPod Network Volumes normally mount at /workspace.
# For local Docker, use ./data instead.
JARVIS_DATA_ROOT=/workspace/jarvis-data

# -----------------------------------------------------------------------------
# Open WebUI
# -----------------------------------------------------------------------------
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:0.13.3
OPEN_WEBUI_BIND=0.0.0.0
OPEN_WEBUI_PORT=3000
WEBUI_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
WEBUI_AUTH=true
# Open WebUI 0.13.3 permits the first administrator bootstrap even when false.
# Re-enable signups temporarily in the admin UI when onboarding another user.
ENABLE_SIGNUP=false
DEFAULT_USER_ROLE=pending
WEBUI_URL=
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# llama.cpp / model
# -----------------------------------------------------------------------------
# Pin builds for reproducibility. Update intentionally after reviewing llama.cpp
# release notes. b12316 was the current upstream snapshot when generated.
LLAMA_CPP_REF=b12316
CUDA_VERSION=12.8.1
LLAMA_IMAGE_TAG=b12316

# Hugging Face token is optional for public repositories and required for gated
# repositories. It is passed only to services that may download local models.
HF_TOKEN=
HF_REPO_ID=unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF
HF_FILENAME=Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf
# For a sharded model, set a glob such as Model-Q4_K_M-*.gguf and set
# MODEL_PATH to the first shard.
HF_MODEL_PATTERN=
MODEL_PATH=/models/Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf
MODEL_ALIAS=qwen3-coder-30b-a3b

LLAMA_API_KEY=change-me-long-random-llama-api-key
LLAMA_CTX_SIZE=16384
LLAMA_PARALLEL=1
LLAMA_N_GPU_LAYERS=99
LLAMA_BATCH_SIZE=2048
LLAMA_UBATCH_SIZE=512
LLAMA_CACHE_TYPE_K=q8_0
LLAMA_CACHE_TYPE_V=q8_0
LLAMA_FLASH_ATTN=on
# Leave blank for llama.cpp auto-detection.
LLAMA_THREADS=
# Space-delimited advanced flags. Do not put shell commands here.
LLAMA_EXTRA_ARGS=

# Compose profile-specific settings. These intentionally take precedence over
# the generic values above when the corresponding override file is selected.
LLAMA_CTX_SIZE_24GB=16384
LLAMA_PARALLEL_24GB=1
LLAMA_N_GPU_LAYERS_24GB=99
LLAMA_CACHE_TYPE_K_24GB=q8_0
LLAMA_CACHE_TYPE_V_24GB=q8_0
LLAMA_CTX_SIZE_48GB=65536
LLAMA_PARALLEL_48GB=2
LLAMA_N_GPU_LAYERS_48GB=99
LLAMA_CACHE_TYPE_K_48GB=q8_0
LLAMA_CACHE_TYPE_V_48GB=q8_0

# -----------------------------------------------------------------------------
# Voice: Speaches (faster-whisper STT + Kokoro/Piper TTS)
# -----------------------------------------------------------------------------
VOICE_IMAGE=ghcr.io/speaches-ai/speaches:0.9.0-rc.3-cpu
VOICE_IMAGE_24GB=ghcr.io/speaches-ai/speaches:0.9.0-rc.3-cpu
VOICE_IMAGE_48GB=ghcr.io/speaches-ai/speaches:0.9.0-rc.3-cuda
VOICE_API_KEY=change-me-long-random-voice-api-key
STT_MODEL=Systran/faster-whisper-small
TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
TTS_VOICE=af_heart
VOICE_PRELOAD_MODELS=["Systran/faster-whisper-small","speaches-ai/Kokoro-82M-v1.0-ONNX"]
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
VOICE_MODEL_TTL=-1

# -----------------------------------------------------------------------------
# Tailscale userspace networking
# -----------------------------------------------------------------------------
TAILSCALE_IMAGE=tailscale/tailscale:v1.104.4
# Prefer a tagged, preauthorized, one-off key; the node state is persistent.
TS_AUTHKEY=change-me-tskey-auth
TS_HOSTNAME=jarvis-runpod
TS_ACCEPT_DNS=false
TS_EXTRA_ARGS=--accept-routes
# RunPod auto-enables this when an auth key or enrolled state exists. Set false
# only for UI-only recovery when Tailnet connectivity is intentionally offline.
TAILSCALE_REQUIRED=

# -----------------------------------------------------------------------------
# Allowlisted SSH tool service
# -----------------------------------------------------------------------------
TOOL_API_KEY=change-me-long-random-tool-api-key
SSH_TARGETS_FILE=./config/ssh-targets.yaml
SSH_KNOWN_HOSTS_FILE=./config/ssh_known_hosts
SSH_PRIVATE_KEY_FILE_NAME=id_ed25519
SSH_ENABLE_MUTATING_COMMANDS=false
SSH_DEFAULT_TIMEOUT=30
SSH_MAX_OUTPUT_BYTES=262144

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_MAX_SIZE=20m
LOG_MAX_FILES=5

# -----------------------------------------------------------------------------
# RunPod single-container deployment
# -----------------------------------------------------------------------------
# RUNPOD_API_KEY is for runpodctl/API automation only. It is never injected into
# an application process by this project.
RUNPOD_API_KEY=
# Used locally to create a private source repository, run the image-build
# workflow, and let RunPod pull the private GHCR image. Use a classic PAT with
# repo, workflow, and read:packages scopes.
GITHUB_USERNAME=
GITHUB_TOKEN=
GITHUB_REPOSITORY=jarvis-runpod
RUNPOD_IMAGE=
RUNPOD_DATA_ROOT=/workspace/jarvis-data
RUNPOD_UI_PORT=3000
# RunPod cannot mount local Compose secrets. Supply the private key and optional
# config as base64-encoded secret environment variables, or place files under
# /workspace/jarvis-config from a secure terminal.
SSH_PRIVATE_KEY_B64=
SSH_TARGETS_YAML_B64=
SSH_KNOWN_HOSTS_B64=
